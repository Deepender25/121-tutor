# Copy to .env and fill in. Never commit .env. (run.bat creates .env from this file if it's missing.)

# Required for voice. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embeddings (how your PDFs are indexed for search):
#   offline = EmbeddingGemma on this computer (default; downloads ~1.5 GB once, works without internet)
#   online  = Gemini Embedding 2 with the GEMINI_API_KEY above (for computers that can't run the local model)
# Switching is safe: sources indexed the other way are re-indexed in the background, keeping your progress.
EMBEDDING_MODEL=offline

# Optional: better web search (1,000 free searches/month at https://tavily.com).
# Without it, web search uses DuckDuckGo (free, no key).
TAVILY_API_KEY=

# Optional overrides
# Ports: the app you open (UI), and the Python API behind it.
# VOICE_TUTOR_PORT=8765
# VOICE_TUTOR_API_PORT=8766
# VOICE_TUTOR_DATA=C:\Users\you\AppData\Local\voice-tutor
# VOICE_TUTOR_LIVE_MODEL=gemini-3.8-live
# How long a pause (ms) ends your turn. Raise it if the tutor cuts in while you're thinking; lower it for snappier replies.
# VOICE_TUTOR_VAD_SILENCE_MS=1000
# How long a sound (ms) must last before it counts as you talking and cuts the tutor off. Stops short bursts (the
# tutor's voice coming back from a phone speaker, a knock) from interrupting; lower it if short answers get missed.
# VOICE_TUTOR_VAD_PREFIX_MS=300
# Online embeddings: texts per minute to stay under (free tier: 100; raise it on a paid tier).
# VOICE_TUTOR_ONLINE_EMBED_PER_MINUTE=100
# Hosting (see deploy/README.md). Leave these unset on your own computer.
# VOICE_TUTOR_AUTH=on                                  sign-in required (one account: python manage.py user create <email>)
# VOICE_TUTOR_PUBLIC_ORIGINS=https://tutor.example.com the frontend's site, allowed to call this API
# VOICE_TUTOR_COOKIE_DOMAIN=tutor.example.com          shared by the frontend and api.tutor.example.com
# HF_TOKEN=   (only needed for the gated EmbeddingGemma v1 fallback)
# VOICE_TUTOR_RECORD_AUDIO=on   diagnostics for sound problems: saves each voice session (both directions) as WAV in <data>/debug-audio, last 6 kept
