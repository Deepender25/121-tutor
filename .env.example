# Copy to .env and fill in. Never commit .env. (run.bat creates .env from this file if it's missing.)

# Required for voice. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Embeddings (how your PDFs are indexed for search):
#   offline = EmbeddingGemma on this computer (default; downloads ~1.5 GB once, works without internet)
#   online  = Gemini Embedding 2 with the GEMINI_API_KEY above (for computers that can't run the local model)
# Switching is safe: sources indexed the other way are re-indexed in the background, keeping your reading position.
EMBEDDING_MODEL=offline

# Web search, and adding web pages as sources. WEB_SEARCH (lowercase) picks the service:
#   tinyfish   = TinyFish Search finds pages, then TinyFish Fetch reads the top ones in a real browser, so answers
#                come from the pages themselves; "Add from a link" can add any web page. Needs TINYFISH_API_KEY
#                (https://agent.tinyfish.ai/api-keys; Search and Fetch have a free daily allowance).
#   tavily     = Tavily search snippets. Needs TAVILY_API_KEY (1,000 free searches/month at https://tavily.com).
#   duckduckgo = DuckDuckGo snippets. Free, no key.
# Leave it empty for the old behaviour: Tavily if TAVILY_API_KEY is set, otherwise DuckDuckGo.
# If the chosen service fails, the next one available answers (TinyFish, then Tavily, then DuckDuckGo).
WEB_SEARCH=
TINYFISH_API_KEY=
TAVILY_API_KEY=
# With TinyFish: how many of the top results to read per search (0-5; 0 = snippets only).
# TINYFISH_FETCH_PAGES=3

# Optional overrides. Each one is commented out; remove the "# " in front of a setting to use it.

# Ports: the app you open (UI), and the Python API behind it.
# VOICE_TUTOR_PORT=8765
# VOICE_TUTOR_API_PORT=8766
# Folder for your notebooks and indexed PDFs; default: voice-tutor in your local AppData (outside OneDrive).
# VOICE_TUTOR_DATA=C:\Users\you\AppData\Local\voice-tutor
# Folder for log files; default: logs in this folder.
# VOICE_TUTOR_LOGS=
# The Gemini Live model that does the talking.
# VOICE_TUTOR_LIVE_MODEL=gemini-3.8-live

# Voice turn-taking.
# How long a pause (ms) ends your turn. Raise it if the tutor cuts in while you're thinking; lower it for snappier replies.
# VOICE_TUTOR_VAD_SILENCE_MS=1000
# How long a sound (ms) must last before it counts as you talking and cuts the tutor off. Stops short bursts (the
# tutor's voice coming back from a phone speaker, a knock) from interrupting; lower it if short answers get missed.
# VOICE_TUTOR_VAD_PREFIX_MS=300
# low or high. low: the tutor's own voice from a phone speaker or background noise doesn't cut it off.
# VOICE_TUTOR_VAD_START_SENSITIVITY=low
# low or high. high: the tutor answers as soon as you've finished, even with faint room noise on the mic (low
# sometimes waited several seconds). How long a pause may be is VOICE_TUTOR_VAD_SILENCE_MS.
# VOICE_TUTOR_VAD_END_SENSITIVITY=high

# Limits.
# Largest PDF you can add, in MB.
# VOICE_TUTOR_MAX_UPLOAD_MB=200
# Voice conversations open at once (each one holds a Gemini Live connection).
# VOICE_TUTOR_MAX_LIVE_SESSIONS=3
# Online embeddings: texts per minute to stay under (free tier: 100; raise it on a paid tier).
# VOICE_TUTOR_ONLINE_EMBED_PER_MINUTE=100

# Only needed for the gated EmbeddingGemma v1 fallback.
# HF_TOKEN=
# Diagnostics for sound problems: saves each voice session (both directions) as WAV in <data>/debug-audio, last 6
# kept. It records your voice: turn it on only while investigating.
# VOICE_TUTOR_RECORD_AUDIO=on

# Hosting (see deploy/README.md). Leave these unset on your own computer.
# Sign-in required (one account: python manage.py user create <email>).
# VOICE_TUTOR_AUTH=on
# The frontend's site, allowed to call this API.
# VOICE_TUTOR_PUBLIC_ORIGINS=https://tutor.example.com
# Shared by the frontend and api.tutor.example.com.
# VOICE_TUTOR_COOKIE_DOMAIN=tutor.example.com
