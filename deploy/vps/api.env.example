# The API server's settings on the VPS. setup.sh copies this to /etc/voice-tutor/api.env
# (readable by root and the service only). Edit that copy, then: sudo voice-tutor restart

# Required: voice + online embeddings. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Web search and "Add from a link": WEB_SEARCH=tinyfish|tavily|duckduckgo (empty: Tavily if its key is set,
# otherwise DuckDuckGo). tinyfish needs TINYFISH_API_KEY; tavily needs TAVILY_API_KEY. See .env.example.
WEB_SEARCH=
TINYFISH_API_KEY=
TAVILY_API_KEY=

# This server can't run the local model (1 GB RAM): embeddings come from Gemini.
EMBEDDING_MODEL=online

# Login: one email + password account (create it with: sudo voice-tutor user create you@example.com).
VOICE_TUTOR_AUTH=on
# The frontend on Vercel: the only site whose pages may call this API.
VOICE_TUTOR_PUBLIC_ORIGINS=https://tutor.edgedrop.app
# The session cookie is shared by tutor.edgedrop.app and api.tutor.edgedrop.app, and by nothing else on the domain.
VOICE_TUTOR_COOKIE_DOMAIN=tutor.edgedrop.app

# The API listens on this machine only; Caddy (HTTPS) is the only way in.
VOICE_TUTOR_HOST=127.0.0.1
VOICE_TUTOR_API_PORT=8766

# Where things live.
VOICE_TUTOR_DATA=/var/lib/voice-tutor/data
VOICE_TUTOR_LOGS=/var/log/voice-tutor
HF_HOME=/var/lib/voice-tutor/cache/huggingface

# Limits for a small server.
VOICE_TUTOR_MAX_UPLOAD_MB=100
VOICE_TUTOR_MAX_LIVE_SESSIONS=2

# Diagnostics for sound problems: record voice sessions (both directions) to /var/lib/voice-tutor/data/debug-audio.
# VOICE_TUTOR_RECORD_AUDIO=on
